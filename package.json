{
  "name": "multi-chat-overlay",
  "version": "3.1.4",
  "description": "Overlay profesional de chat en vivo con clips, alertas y sincronización OBS para TikTok, Twitch, Kick y YouTube",
  "main": "main.js",
  "author": "Luis Sandoval",
  "scripts": {
    "start": "electron .",
    "prepare:piper": "node scripts/prepare-piper.cjs",
    "dist": "npm run prepare:piper && electron-builder --win",
    "release": "npm run prepare:piper && electron-builder --win --publish always",
    "test": "node --test tests/platform-details.test.cjs tests/chat-presentation.test.cjs tests/safe-content.test.cjs tests/obs-server.test.cjs tests/ipc-security.test.cjs tests/capture-policy.test.cjs tests/chat-tools.test.cjs tests/piper.test.cjs tests/tts.test.cjs tests/tiktok.test.cjs tests/music.test.cjs tests/music-bridge.test.cjs tests/music-service.test.cjs tests/music-twitch.test.cjs && node tests/piper-runtime.cjs && electron tests/tiktok-runtime.cjs && electron tests/spotify-regression.cjs && electron tests/main-runtime.cjs && electron tests/ui-smoke.cjs"
  },
  "keywords": [
    "multichat",
    "overlay",
    "tiktok",
    "twitch",
    "kick",
    "youtube",
    "obs",
    "clips"
  ],
  "license": "ISC",
  "dependencies": {
    "electron-updater": "6.8.11",
    "tiktok-live-connector": "^2.4.3",
    "tiktok-live-recorder": "^1.0.4",
    "tmi.js": "1.8.5",
    "ws": "8.21.1",
    "youtube-chat": "^2.2.0"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "overrides": {
    "minimatch@>=7": "11.0.1"
  },
  "build": {
    "appId": "com.luissandoval.multichatoverlay",
    "productName": "Multi Chat Overlay",
    "publish": [
      {
        "provider": "github",
        "owner": "Luissandoval90",
        "repo": "multichat",
        "releaseType": "release"
      }
    ],
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "overlay.html",
      "obs.html",
      "multichat.png",
      "styles/**/*",
      "assets/**/*",
      "src/**/*",
      "platforms/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "multichat.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "extraResources": [
      {
        "from": "vendor/piper/piper",
        "to": "piper"
      },
      {
        "from": "browser-extension",
        "to": "spotify-bridge"
      }
    ]
  }
}
